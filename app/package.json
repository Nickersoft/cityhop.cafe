{
	"name": "cityhop.cafe",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"workspaces": [
		"packages/*",
		"app"
	],
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"prepare": "vp config && svelte-kit sync"
	},
	"devDependencies": {
		"@iconify-json/ph": "^1.2.2",
		"@iconify-json/simple-icons": "^1.2.77",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-vercel": "^7.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.5",
		"tailwindcss": "^4.3.2",
		"typescript": "^6",
		"unplugin-icons": "^24.0.0",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.2.8",
		"bits-ui": "^2.20.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"country-flag-icons": "^1.6.20",
		"country-to-iso": "^1.6.3",
		"dayjs": "^1.11.21",
		"es-toolkit": "^1.49.0",
		"fuzzysort": "^4.0.0",
		"nanoid": "^6.0.0",
		"posthog-js": "^1.398.2",
		"posthog-node": "^5.40.0",
		"svelte-meta-tags": "^5.0.1",
		"svelte-persisted-state": "^1.4.1",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"vaul-svelte": "0.3.2",
		"youtube": "../packages/youtube",
		"zod": "^4.4.3"
	},
	"overrides": {
		"vite": "catalog:"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
