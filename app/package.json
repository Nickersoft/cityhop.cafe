		"#lib/remote/*.remote": "./src/lib/remote/*.remote.ts",
		"#actions/*": "./src/actions/*",
		"#components/ui": "./src/components/ui/index.ts",
		"#components/controls": "./src/components/controls/index.ts",
		"#components/modals": "./src/components/modals/index.ts",
		"#components/*": "./src/components/*",
		"#styles/*": "./src/styles/*",
		"#server/data": "./src/server/data/index.ts",
		"#server/data/scenes": "./src/server/data/scenes/index.ts",
		"#server/data/stations": "./src/server/data/stations/index.ts",
		"#server/schema": "./src/server/schema/index.ts",
		"#server/*": "./src/server/*"
	},
	"catalog": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
		"vite-plus": "1.4.0"
